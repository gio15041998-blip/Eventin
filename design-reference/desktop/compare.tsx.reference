function IconBell({ className }: { className?: string }) {
  return (
    <div className={className || "relative size-[24px]"} data-node-id="4:66" data-name="Icon/bell">
      <img alt="" className="absolute block inset-0 max-w-none size-full" src={imgIconBell} />
    </div>
  );
}

function IconHeart({ className }: { className?: string }) {
  return (
    <div className={className || "relative size-[24px]"} data-node-id="4:22" data-name="Icon/heart">
      <img alt="" className="absolute block inset-0 max-w-none size-full" src={imgIconHeart} />
    </div>
  );
}

type ButtonProps = {
  className?: string;
  label?: string;
  state?: "Default";
  variant?: "Primary" | "Secondary";
};

function Button({ className, label = "Continuar", state = "Default", variant = "Primary" }: ButtonProps) {
  const isSecondaryAndDefault = variant === "Secondary" && state === "Default";
  return (
    <div className={className || `content-stretch flex gap-[var(--space-8,8px)] h-[48px] items-center justify-center px-[var(--space-20,20px)] py-[var(--space-12,12px)] relative rounded-[var(--radius-12,12px)] w-[160px] ${isSecondaryAndDefault ? "bg-[var(--color-subtle,#e7f3ed)]" : "bg-[var(--color-brand,#145c46)]"}`} id={isSecondaryAndDefault ? "node-4_101" : "node-4_93"}>
      {variant === "Primary" && state === "Default" && (
        <p className="[word-break:break-word] font-['Manrope:Bold'] font-bold leading-[20px] relative shrink-0 text-[14px] text-[color:var(--color-inverse,white)] whitespace-nowrap" data-node-id="4:94">
          {label}
        </p>
      )}
      {isSecondaryAndDefault && (
        <p className="[word-break:break-word] font-['Manrope:Bold'] font-bold leading-[20px] relative shrink-0 text-[14px] text-[color:var(--color-brand,#145c46)] whitespace-nowrap" data-node-id="4:102">
          {label}
        </p>
      )}
    </div>
  );
}

function IconMessage({ className }: { className?: string }) {
  return (
    <div className={className || "relative size-[24px]"} data-node-id="4:54" data-name="Icon/message">
      <img alt="" className="absolute block inset-0 max-w-none size-full" src={imgIconMessage} />
    </div>
  );
}

type QuotationCompareProps = {
  className?: string;
  includes?: string;
  price?: string;
  time?: string;
  title?: string;
};

function QuotationCompare({ className, includes = "Decoración de mesa\nMontaje\nRetiro de elementos", price = "S/ 480", time = "2 horas", title = "Mesa & Momento" }: QuotationCompareProps) {
  return (
    <div className={className || "bg-[var(--color-surface,white)] h-[530px] relative rounded-[var(--radius-16,16px)] w-[390px]"} data-node-id="12:193" data-name="Quotation/Compare">
      <p className="[word-break:break-word] absolute font-['Manrope:Bold'] font-bold leading-[30px] left-[24px] text-[22px] text-[color:var(--color-text,#172d28)] top-[24px] whitespace-nowrap" data-node-id="12:194">
        {title}
      </p>
      <p className="[word-break:break-word] absolute font-['Manrope:Bold'] font-bold leading-[52px] left-[24px] text-[36px] text-[color:var(--color-brand,#145c46)] top-[77px] whitespace-nowrap" data-node-id="12:195">
        {price}
      </p>
      <p className="[word-break:break-word] absolute font-['Manrope:Regular'] font-normal leading-[17px] left-[24px] text-[12px] text-[color:var(--color-secondary,#566a63)] top-[139px] whitespace-nowrap" data-node-id="12:196">
        Propuesta de ejemplo
      </p>
      <div className="absolute bg-[var(--color-border,#dce4df)] h-px left-[24px] top-[184px] w-[342px]" data-node-id="12:197" data-name="border" />
      <p className="[word-break:break-word] absolute font-['Manrope:Bold'] font-bold leading-[20px] left-[24px] text-[14px] text-[color:var(--color-text,#172d28)] top-[211px] whitespace-nowrap" data-node-id="12:198">
        Incluye
      </p>
      <div className="[word-break:break-word] absolute font-['Manrope:Regular'] font-normal leading-[0] left-[24px] text-[16px] text-[color:var(--color-secondary,#566a63)] top-[250px] w-[342px]" data-node-id="12:199">
        {includes ? (
          <p className="leading-[24px] mb-0">{includes}</p>
        ) : (
          <>
            <p className="leading-[24px] mb-0">Decoración de mesa</p>
            <p className="leading-[24px] mb-0">Montaje</p>
            <p className="leading-[24px]">Retiro de elementos</p>
          </>
        )}
      </div>
      <p className="[word-break:break-word] absolute font-['Manrope:Regular'] font-normal leading-[17px] left-[24px] text-[12px] text-[color:var(--color-secondary,#566a63)] top-[370px] whitespace-nowrap" data-node-id="12:200">
        Duración del montaje
      </p>
      <p className="[word-break:break-word] absolute font-['Manrope:SemiBold'] font-semibold leading-[23px] left-[24px] text-[16px] text-[color:var(--color-text,#172d28)] top-[398px] whitespace-nowrap" data-node-id="12:201">
        {time}
      </p>
      <Button className="absolute bg-[var(--color-subtle,#e7f3ed)] content-stretch flex gap-[var(--space-8,8px)] h-[48px] items-center justify-center left-[24px] px-[var(--space-20,20px)] py-[var(--space-12,12px)] rounded-[var(--radius-12,12px)] top-[458px] w-[342px]" label="Ver condiciones" variant="Secondary" />
    </div>
  );
}

