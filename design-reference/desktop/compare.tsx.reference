const imgIconBell = "https://www.figma.com/api/mcp/asset/b0df8129-7165-441a-b891-4cc272d56bfb.svg";
const imgIconHeart = "https://www.figma.com/api/mcp/asset/313995c9-09c4-437f-9fac-dfb5a444096a.svg";
const imgIconMessage = "https://www.figma.com/api/mcp/asset/4057f79f-2102-4abe-9edd-e78dda080961.svg";
