      <p className="[word-break:break-word] absolute font-['Manrope:Bold'] font-bold leading-[49px] left-[80px] text-[34px] text-[color:var(--color-text,#172d28)] top-[132px] w-[1280px]" data-node-id="53:759">
        Mis eventos públicos
      </p>
      <div className="absolute bg-[var(--color-surface,white)] h-[465px] left-[80px] overflow-clip rounded-[var(--radius-16,16px)] top-[263px] w-[1280px]" data-node-id="53:760" data-name="Seguimiento de publicación">
        <IconClock className="absolute left-[32px] size-[44px] top-[32px]" />
