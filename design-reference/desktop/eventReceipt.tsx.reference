        <div className="[word-break:break-word] absolute font-['Manrope:Regular'] font-normal leading-[0] left-[32px] text-[19px] text-[color:var(--color-secondary,#566a63)] top-[278px] w-[1216px]" data-node-id="53:766">
          <p className="leading-[28px] mb-0">Pago: por verificar.</p>
