type ButtonProps = {
  className?: string;
  label?: string;
  state?: "Default";
  variant?: "Primary";
};

function Button({ className, label = "Continuar", state = "Default", variant = "Primary" }: ButtonProps) {
  return (
    <div className={className || "bg-[var(--color-brand,#145c46)] content-stretch flex gap-[var(--space-8,8px)] h-[48px] items-center justify-center px-[var(--space-20,20px)] py-[var(--space-12,12px)] relative rounded-[var(--radius-12,12px)] w-[160px]"} data-node-id="4:93">
