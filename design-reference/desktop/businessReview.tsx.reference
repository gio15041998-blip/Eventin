const imgBrandIsotipo = "https://www.figma.com/api/mcp/asset/1f3de8a0-a1f3-4f82-9c72-19fb24011be4.svg";
const imgFotoTable = "https://www.figma.com/api/mcp/asset/99762c38-36fa-4d46-b259-f74a9e3cc0c5.png";

type ButtonProps = {
  className?: string;
  label?: string;
  state?: "Default";
  variant?: "Primary" | "Secondary";
};

function Button({ className, label = "Continuar", state = "Default", variant = "Primary" }: ButtonProps) {
  const isSecondaryAndDefault = variant === "Secondary" && state === "Default";
  return (
    <div className={className || `content-stretch flex gap-[var(--space-8,8px)] h-[48px] items-center justify-center px-[var(--space-20,20px)] py-[var(--space-12,12px)] relative rounded-[var(--radius-12,12px)] w-[160px] ${isSecondaryAndDefault ? "bg-[var(--color-subtle,#e7f3ed)]" : "bg-[var(--color-brand,#145c46)]"}`} id={isSecondaryAndDefault ? "node-4_101" : "node-4_93"}>
      {variant === "Primary" && state === "Default" && (
        <p className="[word-break:break-word] font-['Manrope:Bold'] font-bold leading-[20px] relative shrink-0 text-[14px] text-[color:var(--color-inverse,white)] whitespace-nowrap" data-node-id="4:94">
          {label}
        </p>
      )}
      {isSecondaryAndDefault && (
        <p className="[word-break:break-word] font-['Manrope:Bold'] font-bold leading-[20px] relative shrink-0 text-[14px] text-[color:var(--color-brand,#145c46)] whitespace-nowrap" data-node-id="4:102">
          {label}
        </p>
      )}
    </div>
  );
}

function BrandIsotipo({ className }: { className?: string }) {
  return (
    <div className={className || "relative size-[40px]"} data-node-id="4:84" data-name="Brand/Isotipo">
      <img alt="" className="absolute block inset-0 max-w-none size-full" src={imgBrandIsotipo} />
    </div>
  );
}

function BrandLogotipo({ className }: { className?: string }) {
  return (
    <div className={className || "h-[40px] relative w-[166px]"} data-node-id="4:85" data-name="Brand/Logotipo">
      <BrandIsotipo className="absolute left-0 size-[40px] top-0" />
      <p className="[word-break:break-word] absolute font-['Manrope:ExtraBold'] font-extrabold leading-[44px] left-[50px] text-[30px] text-[color:var(--color-text,#172d28)] top-[-2px] whitespace-nowrap" data-node-id="4:91">
        eventin
      </p>
    </div>
  );
}

