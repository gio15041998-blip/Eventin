        <p className="leading-[20px]">Mi cuenta</p>
      </a>
      <p className="[word-break:break-word] absolute font-['Manrope:Bold'] font-bold leading-[49px] left-[80px] text-[34px] text-[color:var(--color-text,#172d28)] top-[132px] w-[1280px]" data-node-id="53:529">
        Panel de negocios
      </p>
      <div className="absolute bg-[var(--color-surface,white)] h-[534px] left-[80px] overflow-clip rounded-[var(--radius-16,16px)] top-[263px] w-[832px]" data-node-id="53:530" data-name="Vista previa de ficha">
        <div className="absolute h-[210px] left-[24px] rounded-[var(--radius-12,12px)] top-[24px] w-[784px]" data-node-id="53:531" data-name="Foto/table">
